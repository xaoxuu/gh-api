{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "regions": ["iad1"],
  "functions": { "api/index.ts": { "maxDuration": 30 } },
  "routes": [
    { "src": "^/(?:rate_limit|(?:repos|users|orgs)(?:/.*)?)?$", "dest": "/api/index" },
    { "handle": "filesystem" }
  ]
}
