# Fine-grained PAT: Public repositories (read-only). Never put this in frontend code.
GITHUB_TOKEN=
# Owner grants all public repos + profile/list. Owner/repo grants only that repo.
GITHUB_ALLOWLIST=xaoxuu,vercel/next.js
# Optional settings: defaults work without configuring these.
# CACHE_TTL_SECONDS=1800
# CACHE_MAX_AGE_SECONDS=86400
# CACHE_NAMESPACE=gh-api
# CACHE_VERSION=1
# * or comma-separated exact origins, with no trailing slash.
# CORS_ORIGINS=*
# GITHUB_TIMEOUT_MS=10000
